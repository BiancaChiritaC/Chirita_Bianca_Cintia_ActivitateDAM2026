<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AdaugaBicicleta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/tvTitlu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/introducere_date_bicicleta"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <EditText
    android:id="@+id/etMarca"
    android:layout_width="match_parent"
    android:layout_height="48dp"
        android:autofillHints="personName"
        android:hint="@string/marca"
    android:inputType="text"
    android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tip"
        android:textStyle="bold"/>

    <RadioButton
        android:id="@+id/rbMunte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bicicleta de munte"
        android:checked="true" />

    <RadioButton
        android:id="@+id/rbStrada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bicicleta pentru strada" />

    <RadioButton
        android:id="@+id/rbTeren"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bicicleta de teren" />

    <CheckBox
        android:id="@+id/cbStoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bicicleta este disponibilă în stoc"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selectați culoarea bicicletei:"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spCuloare"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:entries="@array/culori"/>

    <Switch
        android:id="@+id/swElectrica"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/bicicleta_electrica"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/starea_bicicletei"
        android:textStyle="bold" />

    <RatingBar
        android:id="@+id/rbRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSalvare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="adaugaBicicleta"
            android:text="@string/adauga" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>